# ==============================================================================
# SUTRAM Digital Forensics - Frontend (apps/web) Environment Template
# Copy to apps/web/.env.local for local development. Never commit .env files.
#
# Vite only loads .env files from apps/web/ (its project root), NOT from the
# repository root. Only variables prefixed with VITE_ are exposed to the
# browser bundle, so never place secrets here.
# ==============================================================================

# Base URL of the FastAPI backend (no trailing slash required).
# Falls back to http://localhost:8000 when unset or empty.
VITE_API_URL=http://localhost:8000
