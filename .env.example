# ==============================================================================
# SUTRAM Digital Forensics - Environment Configuration Template
# NOTE: Copy this file to .env for local development. Never commit .env to Git!
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Backend PostgreSQL Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sutram_forensics

# Backend Neo4j Knowledge Graph Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ChangeMeInLocalEnv123!

# Secure Local Evidence Storage (Path outside git tracking)
EVIDENCE_STORAGE_PATH=./data/evidence_storage

# Decision Service URL (Node.js / Laya / ONNX runtime placeholder)
DECISION_SERVICE_URL=http://localhost:3001

# Frontend Configuration
VITE_API_URL=http://localhost:8000
