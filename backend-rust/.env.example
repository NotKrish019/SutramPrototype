# SUTRAM / YUKTI Rust Backend - Environment Configuration Example
# Copy this file to .env for local development. Never commit .env to Git!

HOST=127.0.0.1
PORT=8080
RUST_LOG=info,sutram_backend_rust=debug,tower_http=debug

# Storage paths (relative to workspace or absolute)
EVIDENCE_STORAGE_PATH=data/evidence/raw
DERIVED_STORAGE_PATH=data/evidence/derived
MAX_UPLOAD_SIZE_BYTES=52428800

# PostgreSQL 16 Database Configuration (Optional; if unset, runs in memory/fs mode)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sutram_forensics
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=1
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Neo4j Digital Forensic Knowledge Graph Configuration (Optional; if unset, runs without graph projection)
GRAPH_ENABLED=true
NEO4J_URI=http://127.0.0.1:7474
NEO4J_DATABASE=neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=forensic_graph_password_2026
NEO4J_TIMEOUT_SECONDS=10

# HMAC-SHA-256 Key for Technical Identifier Privacy (Optional; if unset, unkeyed fallback is used)
# Provide a 64-character hex string (32 bytes entropy) for production deployments
GRAPH_IDENTIFIER_HMAC_KEY=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
